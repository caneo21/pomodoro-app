<Window
    x:Class="PomodoroWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="CaptionButtonsReserveColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="Assets/Square44x44Logo.png" Width="16" Height="16" Margin="16,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Pomodoro" VerticalAlignment="Center" FontSize="12"/>
            <Button x:Name="ModeToggleButton" Grid.Column="3" Content="미니" Click="ModeToggleButton_Click"
                    VerticalAlignment="Center" Margin="0,0,4,0" Padding="12,4" FontSize="12" CornerRadius="999"/>
        </Grid>

        <InfoBar x:Name="UpdateInfoBar" Grid.Row="1" Margin="12,0,12,8"
                 IsOpen="False" IsClosable="True" IsIconVisible="False" Severity="Informational"
                 Closed="UpdateInfoBar_Closed" SizeChanged="UpdateInfoBar_SizeChanged">
            <InfoBar.ActionButton>
                <Button Content="다운로드" Click="UpdateDownloadButton_Click"/>
            </InfoBar.ActionButton>
        </InfoBar>

        <Frame x:Name="RootFrame" x:FieldModifier="public" Grid.Row="2"/>
    </Grid>
</Window>
